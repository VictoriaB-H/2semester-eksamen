---
// AssignmentsCard.astro
const { overskrift, beskrivelse, link, readmore } = Astro.props;

// Skip rendering if required props are missing
if (!overskrift || !beskrivelse || !readmore) {
  return null;
}
---

<article class="card">
  <h4>{overskrift}</h4>
  <p class="beskrivelse">{beskrivelse}</p>
  <details>
    <summary class="readmore">+ {readmore}</summary>
    <div class="goder-text">
      <ul>
        <li>Partout festivalarmbånd</li>
        <li>4x drinksbilletter</li>
        <li>Invitation til frivilligfest</li>
        <li>En mega sjov og fed tid sammen med andre frivillige</li>
      </ul>
    </div>
  </details>
</article>

<style>
  .card {
    border: 1px solid white;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-width: 230px;
  }
  h4 {
    text-align: center;
    margin: 0;
    margin-bottom: 10px;
  }

  .beskrivelse {
    font-size: 1rem;
    line-height: 1.5;
    margin: 0 0 1.5rem 0;
  }

  details {
    border-top: 1px solid white;
    padding-top: 1rem;
    cursor: pointer;
  }

  summary {
    font-size: 1.2rem;
    font-family: owners-text, sans-serif;
    color: white;
    transition: color 0.2s ease;
    cursor: pointer;
    list-style: none;
    outline: none;
    -webkit-appearance: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .goder-text {
    margin-top: 1rem;
    font-size: 0.95rem;
    font-family: owners-text, sans-serif;
  }
  .goder-text ul {
    padding-left: 1.2rem;
    margin: 0;
  }

  .goder-text li {
    margin-bottom: 0.5rem;
  }
  .readmore {
    font-family: owners-text, sans-serif;
  }
  summary {
    font-size: 1.2rem;
    list-style: none;
    outline: none;
    color: white;
    transition: color 0.2s ease;
    cursor: pointer;
  }

  summary:hover {
    color: #fffa3c; /* GUL */
  }
  @media (max-width: 768px) {
    .card {
      scroll-snap-align: center;
      flex: 0 0 80%;
      min-width: 280px;
      margin: 0 auto; /* ← Centrerer kortet i containeren */
    }
  }
</style>
