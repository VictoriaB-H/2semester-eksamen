---
const { overskrift, beskrivelse, readmore } = Astro.props;

if (!overskrift || !beskrivelse || !readmore) {
  return null;
}
---

<article class="card">
  <h4>{overskrift}</h4>
  <p class="beskrivelse">{beskrivelse}</p>
  <details>
    <summary class="readmore">+ {readmore}</summary>
    <ul class="goder-text">
      <li>Partout festivalarmbånd</li>
      <li>4x drinksbilletter</li>
      <li>Invitation til frivilligfest</li>
      <li>En mega sjov og fed tid sammen med andre frivillige</li>
    </ul>
  </details>
</article>

<style>
  .card {
    border: 1px solid white;
    padding: 1.5rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 250px;
  }

  h4 {
    text-align: center;
    margin-top: 10px;
    font-size: 1.2rem;
  }

  .beskrivelse {
    font-size: 1rem;
    line-height: 1.5;
    margin: 0 0 1.5rem 0;
  }

  details {
    border-top: 1px solid white;
    cursor: pointer;
  }

  summary {
    font-size: 1.2rem;
    list-style: none;
    outline: none;
    transition: color 0.2s ease;
    cursor: pointer;
    font-family: owners-text, sans-serif;
    margin-top: 10px;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    color: #fffa3c;
  }

  .goder-text {
    margin-top: 1rem;
    font-size: 0.95rem;
    font-family: owners-text, sans-serif;
    padding-left: 1.2rem;
  }

  .goder-text li {
    margin-bottom: 0.5rem;
    list-style-type: disc;
  }

  @media (max-width: 768px) {
    .card {
      min-width: 280px;
    }
  }
</style>
