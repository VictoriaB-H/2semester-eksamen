---
import VolunteerInfo from "../components/VolunteerInfo.astro";
---

<div class="grid_blivfrivillig">
  <div class="frivillig_bilder">
    <img class="bilde3" src="../img/frivillig_bilde3.webp" alt="" />
    <img class="bilde2" src="../img/frivillig_bilde2.webp" alt="" />
    <img class="bilde1" src="../img/frivillig_bilde1.webp" alt="" />
  </div>
  <div>
    <VolunteerInfo />
  </div>
</div>

<style>
  img {
    max-width: 100%;
  }

  .bilde3 {
    max-width: 90%;
  }

  .frivillig_bilder {
    display: grid;
    grid-template-columns: 1fr;
    padding: 30px;
    position: relative;
    width: 300px; /* mobil */
    height: 400px;
    margin: auto;
    transition:
      width 0.5s ease,
      padding 0.5s ease; /* Tilføj smooth transition */
  }

  .frivillig_bilder img {
    grid-column: 1;
    grid-row: 1;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: auto;
    transform-origin: center;
    transition: transform 1s ease;
  }

  .frivillig_bilder img:nth-child(1) {
    transform: rotate(-7deg);
  }
  .frivillig_bilder img:nth-child(2) {
    transform: rotate(5deg);
  }
  .frivillig_bilder img:nth-child(3) {
    transform: rotate(-3deg);
  }

  @media (min-width: 768px) {
    .grid_blivfrivillig {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 50px;
      margin-bottom: 70px;
    }

    .frivillig_bilder {
      padding: 0px;
      width: 350px; /* tablet */
    }
  }

  @media (min-width: 1150px) {
    .grid_blivfrivillig {
      margin-bottom: 120px;
    }

    .frivillig_bilder {
      width: 400px; /* desktop */
      margin-top: 15px;
    }
  }
  @media (min-width: 1270px) {
    .grid_blivfrivillig {
      gap: 0px;
      padding: 0 95px;
    }
  }
</style>

<script>
  const images = document.querySelectorAll(".frivillig_bilder img");
  let currentTop = images.length - 1;

  setInterval(() => {
    images.forEach((img, index) => {
      img.style.zIndex = index === currentTop ? images.length : index;
    });

    currentTop = (currentTop - 1 + images.length) % images.length;
  }, 2000); // Skifter billede hvert 2. sekund
</script>
