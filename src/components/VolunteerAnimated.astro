---
import VolunteerInfo from "../components/VolunteerInfo.astro";
---

<div class="grid_blivfrivillig">
  <div class="frivillig_bilder">
    <img class="bilde3" src="../../public/img/frivillig_bilde3.webp" alt="" />
    <img class="bilde2" src="../../public/img/frivillig_bilde2.webp" alt="" />
    <img class="bilde1" src="../../public/img/frivillig_bilde1.webp" alt="" />
  </div>
  <div>
    <VolunteerInfo />
  </div>
</div>

<style>
  img {
    max-width: 100%;
  }

  .bilde3 {
    max-width: 90%;
  }

  .frivillig_bilder {
    display: grid;
    grid-template-columns: 1fr;
    padding: 30px;
    position: relative;
    width: 400px; /* juster størrelse etter behov */
    height: 400px;
    margin: auto;
  }

  .frivillig_bilder img {
    grid-column: 1;
    grid-row: 1;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: auto;
    transform-origin: center;
    transition:
      transform 1s ease,
      top 1s ease,
      left 1s ease;
    animation: stackInn 6s infinite;
  }

  .frivillig_bilder img:nth-child(1) {
    transform: rotate(-7deg);
    z-index: 1;
    animation-delay: 0s;
  }
  .frivillig_bilder img:nth-child(2) {
    transform: rotate(5deg);
    z-index: 2;
    animation-delay: 2s;
  }
  .frivillig_bilder img:nth-child(3) {
    transform: rotate(-3deg);
    z-index: 3;
    animation-delay: 4s;
  }

  @media (min-width: 768px) {
    .grid_blivfrivillig {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 50px;
    }

    .frivillig_bilder {
      padding: 0px;
    }
  }

  @media (min-width: 1150px) {
    .grid_blivfrivillig {
      padding: 100px;
    }
  }

  @keyframes stackInn {
    0% {
      top: -80px;
      left: -80px;
      opacity: 0.7;
    }
    30%,
    60% {
      top: 0px;
      left: 0px;
      opacity: 1;
    }
    100% {
      top: 80px;
      left: 80px;
      opacity: 0.7;
    }
  }
</style>
