---
const { isHome = false } = Astro.props;
---

<!-- === HTML / Struktur === -->
<header class={`site-header ${isHome ? "home-header" : "default-header"}`}>
  <h1 class="logo">
    <a href="/" class="logo-link">Av, Min Guldtand</a>
  </h1>

  <div class="burger" id="burger">
    <span></span>
    <span></span>
    <span></span>
  </div>

  <!-- Navigation -->
  <nav class="nav-menu" id="navMenu">
    <div class="menu-top">
      <h1 class="menu-logo">Av, Min Guldtand</h1>
    </div>

    <div class="menu-content">
      <!-- Navigation – bruges både til mobil og desktop -->
      <ul class="nav-links">
        <li><a href="/program">Program</a></li>
        <li><a href="/tickets">Billetter</a></li>
        <li><a href="/volunteer">Bliv frivillig</a></li>
        <li><a href="/aboutus">Om os</a></li>
      </ul>

      <!-- Kun synlig på mobil -->
      <img
        src="../img/Hundillustration.webp"
        alt="Illustration"
        class="nav-illustration mobile-only"
      />

      <div class="some-links mobile-only">
        <p><strong>Følg med her</strong></p>
        <a href="https://www.instagram.com/avminguldtand/">Instagram</a>
        <a href="https://www.tiktok.com/@av.min.guldtand">TikTok</a>
        <a href="https://www.facebook.com/AvMinGuldtand">Facebook</a>
      </div>
    </div>
  </nav>
</header>

<!-- === CSS === -->
<style>
  * {
    box-sizing: border-box;
  }

  /* Andre sider (hvid tekst) */
  .default-header {
    color: white;
  }

  .default-header .burger span {
    background: white;
  }

  .default-header .nav-links a {
    color: white;
  }

  .default-header .logo-link {
    color: white;
  }

  .logo a {
    text-decoration: none;
    color: inherit;
    display: inline-block;
  }

  .site-header {
    position: absolute;
    top: 0;
    width: 100%;
    padding: 25px 15px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 100;
    color: black;
  }

  .logo,
  .menu-logo {
    font-size: 25px;
    margin: 0;
    white-space: nowrap;
  }

  /* === BURGER === */
  .burger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    cursor: pointer;
    z-index: 110;
    transition: 0.3s ease;
  }

  .burger span {
    width: 30px;
    height: 3px;
    background: black;
    transition: 0.3s ease;
  }

  .burger.open span:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }

  .burger.open span:nth-child(2) {
    opacity: 0;
  }

  .burger.open span:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  .burger:hover span,
  .burger.open span {
    background: #fffa3c !important;
  }

  /* === NAV MENU === */
  .nav-menu {
    position: fixed;
    top: -100%;
    left: 0;
    width: 100%;
    height: 90%;
    background-color: black;
    color: white;
    transition: top 0.4s ease-in-out;
  }

  .nav-menu.active {
    top: 0;
  }

  .menu-top {
    display: flex;
    padding: 25px 15px;
  }

  .menu-content {
    text-align: center;
  }

  .nav-links {
    list-style: none;
    padding: 0;
    margin-top: 25px;
  }

  .nav-links li {
    margin-bottom: 15px;
  }

  .nav-links a {
    font-size: 25px;
    text-decoration: none;
    color: white;
    font-family: "Anton", sans-serif;
  }

  .default-header .nav-links a:hover,
  .nav-links a:hover {
    color: #fffa3c;
  }

  .nav-illustration {
    max-width: 80px;
  }

  .some-links {
    display: flex;
    flex-direction: column;
  }

  .some-links a {
    line-height: 1.5;
    color: white;
    text-decoration: none;
    font-family: "owners-text", sans-serif;
  }

  .some-links a:hover {
    color: #fffa3c;
  }

  body.no-scroll {
    overflow: hidden;
  }
  /* === Desktop styling === */
  @media (min-width: 768px) {
    .site-header {
      padding: 0px 25px;
    }

    .burger {
      display: none;
    }

    .nav-menu {
      position: static;
      background: transparent;
    }

    .menu-top {
      display: none;
    }

    .menu-content {
      display: flex;
      justify-content: flex-end;
      gap: 55px;
    }

    .nav-links {
      display: flex;
      gap: 55px;
      margin-top: 30px;
    }

    .nav-links a {
      color: black;
    }

    .nav-links a:hover {
      color: #fffa3c;
    }

    .mobile-only {
      display: none;
    }
  }
</style>

<!-- === JavaScript === -->
<script>
  const burger = document.getElementById("burger");
  const navMenu = document.getElementById("navMenu");

  burger.addEventListener("click", () => {
    const isOpen = burger.classList.toggle("open");
    navMenu.classList.toggle("active");

    // Tilføj eller fjern no-scroll på body
    document.body.classList.toggle("no-scroll", isOpen);
  });
</script>
