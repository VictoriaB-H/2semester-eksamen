<header class="site-header">
  <h1 class="logo">Av, Min Guldtand</h1>

  <div class="burger" id="burger">
    <span></span>
    <span></span>
    <span></span>
  </div>

  <nav class="nav-menu" id="navMenu">
    <div class="menu-top">
      <h1 class="menu-logo">Av, Min Guldtand</h1>
    </div>

    <div class="menu-content">
      <ul class="nav-links">
        <li><a href="/program">Program</a></li>
        <li><a href="/tickets">Billetter</a></li>
        <li><a href="/volunteer">Bliv frivillig</a></li>
        <li><a href="/aboutus">Om os</a></li>
      </ul>

      <img
        src="img/Hundillustration.webp"
        alt="Illustration"
        class="nav-illustration"
      />

      <div class="some-links">
        <p>Følg med her</p>
        <a href="https://www.instagram.com/avminguldtand/">Instagram</a>
        <div><a href="https://www.tiktok.com/@av.min.guldtand">TikTok</a></div>
        <div><a href="https://www.facebook.com/AvMinGuldtand">Facebook</a></div>
      </div>
    </div>
  </nav>
</header>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  /* === HEADER === */
  header.site-header {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    padding: 1rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 100;
    color: black;
  }

  .logo {
    font-size: 1.5rem;
    font-weight: bold;
  }

  /* === BURGER ICON === */
  .burger {
    display: flex;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    z-index: 110;
    transition: 0.3s ease;
  }

  .burger span {
    display: block;
    width: 30px;
    height: 3px;
    background: black;
    transition: 0.3s ease;
  }

  .burger.open span:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }

  .burger.open span:nth-child(2) {
    opacity: 0;
  }

  .burger.open span:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  .burger:hover span {
    background: #fffa3c;
  }

  .burger.open span {
    background: #fffa3c;
  }

  /* === BURGER MENU === */
  .nav-menu {
    position: fixed;
    top: -100%;
    left: 0;
    width: 100%;
    height: 80%;
    background: rgba(0, 0, 0, 0.95);
    color: white;
    z-index: 100;
    display: flex;
    flex-direction: column;
    padding: 2rem 1.5rem;
    transition: top 0.4s ease-in-out;
    overflow-y: auto;
    box-sizing: border-box;
  }

  .nav-menu.active {
    top: 0;
  }

  /* === MENU-TOP (overskrift til venstre) === */
  .menu-top {
    width: 100%;
    max-width: 500px;
    display: flex;
    justify-content: flex-start;
  }

  .menu-logo {
    color: white;
    font-size: 1.4rem;
    font-weight: bold;
    margin-bottom: 1rem;
    text-align: left;
    word-break: break-word;
  }

  /* === CENTRERET INDHOLD === */
  .menu-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
  }

  .nav-links {
    list-style: none;
    margin-bottom: 2rem;
    width: 100%;
    max-width: 500px;
  }

  .nav-links li {
    margin: 1rem 0;
  }

  .nav-links a {
    font-size: 1.5rem;
    text-decoration: none;
    font-weight: bold;
    color: white;
    word-wrap: break-word;
  }

  .nav-links a:hover {
    color: #fffa3c;
  }

  .nav-illustration {
    max-width: 100px;
    margin-bottom: 1.5rem;
    margin-top: -40px;
  }

  .some-links {
    font-size: 1rem;
  }

  .some-links p {
    font-weight: bold;
    margin-bottom: 0.3rem;
  }

  .some-links a {
    display: block;
    color: white;
    text-decoration: none;
    margin: 0.25rem 0;
  }

  .some-links a:hover {
    color: #fffa3c;
  }
  /* === DESKTOP === */
  @media (min-width: 750px) {
    .burger,
    .close,
    .nav-illustration,
    .some-links {
      display: none;
    }

    .menu-logo {
      display: none;
    }

    header.site-header {
      background: transparent;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      padding: 1rem 2rem;
    }

    .logo {
      white-space: nowrap;
      font-size: 1.6rem;
    }

    .nav-menu {
      display: flex !important;
      justify-content: flex-end;
      align-items: flex-start;
      background: none;
      position: static;
      height: auto;
      top: auto;
      overflow: visible;
      padding: 0;
      width: 100%; /* <- Denne linje er afgørende! */
    }

    .nav-links {
      display: flex;
      flex-direction: row;
      gap: 2rem;
      margin: 0;
    }

    .nav-links li {
      margin: 0;
    }

    .nav-links a {
      font-size: 1.4rem;
      color: black;
      padding: 2rem 0;
      text-decoration: none;
      font-weight: bold;
    }

    .nav-links a:hover {
      color: #fffa3c;
    }
  }
</style>

<script>
  const burger = document.getElementById("burger");
  const navMenu = document.getElementById("navMenu");

  burger.addEventListener("click", () => {
    navMenu.classList.toggle("active");
    burger.classList.toggle("open");
  });
</script>
